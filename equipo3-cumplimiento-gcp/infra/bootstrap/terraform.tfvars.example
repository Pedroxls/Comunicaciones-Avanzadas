# Copiar a terraform.tfvars (no se sube al repositorio) y llenar.
project_id        = "cambia-por-el-proyecto-dev"
billing_account   = "000000-000000-000000"
budget_amount_usd = 50
# Misma moneda que la cuenta de facturación. USD es el default de variables.tf.
# budget_currency = "MXN"
region            = "us-central1"
github_repository = "Pedroxls/Comunicaciones-Avanzadas"

# Personas (RF-14). Forma: "user:correo@dominio".
# miembros_plataforma   = []
# miembros_seguridad    = []
# miembros_cumplimiento = []
# miembros_auditoria    = []

# Retención de la evidencia, en segundos. El default de variables.tf es 86400 (un día)
# y no se cambia en el repositorio. 30 días, sin candado, solo en este archivo local:
# evidence_retention_seconds = 2592000
# lock_evidence_retention queda en false.

# Encender cuando exista lo que cada uno necesita (docs/runbooks/puesta-en-marcha.md).
# usar_vertex      = true   # después de confirmar la cuota de Vertex AI (R-07)
# slack_habilitado = true   # después de cargar el token en el secreto slack-bot-token
